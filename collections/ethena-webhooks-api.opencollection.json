{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ethena Learner Training Campaigns Webhooks API",
    "version": "1.3.0"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goethena.com/v1/webhooks",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get all webhooks."
        },
        {
          "info": {
            "name": "Create a new webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.goethena.com/v1/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a new webhook."
        },
        {
          "info": {
            "name": "Get a webhook by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goethena.com/v1/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get a webhook."
        },
        {
          "info": {
            "name": "Update webhook by id",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.goethena.com/v1/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Update a webhook."
        },
        {
          "info": {
            "name": "Delete a webhook by id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.goethena.com/v1/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Delete a webhook. This is a **hard delete**. The deleted webhook will no longer be accessible via the API. This operation is irreversible. If a webhook is deleted by mistake, a new webhook will need to be created."
        },
        {
          "info": {
            "name": "Trigger a webhook by id",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.goethena.com/v1/webhooks/:id/trigger",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Trigger a webhook manually, without needing to perform the action that would normally trigger the webhook."
        }
      ]
    }
  ],
  "bundled": true
}